// Renovate (the Mend-hosted GitHub app) keeps every pin in this repo current.
// What it covers, and what it can't, is in CONTRIBUTING.md.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    // Recommended defaults, plus: GitHub Actions and container images pinned
    // to digests, and config migration PRs.
    'config:best-practices',
    // pre-commit hooks, pinned to commits by `pre-commit autoupdate --freeze`.
    ':enablePreCommit',
  ],
  labels: ['dependencies'],

  // Only take releases that are at least 30 days old, so a hijacked or
  // malicious release has time to be found and pulled before it reaches us.
  // Renovate proposes the newest release that is old enough. Updates with no
  // release date (the Flatpak builder image, runner images) wait on the
  // Dependency Dashboard for someone to tick them, and never merge on their
  // own. Pending releases don't get a branch until they are old enough.
  minimumReleaseAge: '30 days',
  minimumReleaseAgeBehaviour: 'timestamp-required',
  internalChecksFilter: 'strict',

  // Security fixes from the OSV database, for every ecosystem here. They wait
  // the same 30 days (Renovate's default is to propose them at once).
  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    minimumReleaseAge: '30 days',
  },

  // Renovate merges routine updates itself, and only once every check on the
  // PR has passed. GitHub's own auto-merge is off because it waits only for
  // the checks branch protection requires.
  platformAutomerge: false,

  // Lock file refreshes are off: they take the newest version of everything
  // in a lock at once, with no age check. Locks change only along with the
  // update that needs them.
  lockFileMaintenance: {
    enabled: false,
  },

  // Each Python *.lock file is generated, with hashes, from the .txt file of
  // the same name. pip-compile updates the .txt and regenerates the lock;
  // pip_requirements would update the .txt alone. The lock command in each
  // header has --exclude-newer=P30D, so the packages a lock pulls in are
  // held to 30 days as well.
  'pip-compile': {
    managerFilePatterns: [
      '/^infra/ansible/requirements(-[a-z]+)?\\.lock$/',
      '/^\\.github/requirements/[^/]+\\.lock$/',
    ],
    // On by default for this manager.
    lockFileMaintenance: {
      enabled: false,
    },
  },
  pip_requirements: {
    enabled: false,
  },

  customManagers: [
    {
      customType: 'regex',
      description: 'Tool versions in workflows, marked with a "# renovate:" comment',
      managerFilePatterns: ['/^\\.github/workflows/[^/]+\\.ya?ml$/'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?\\s*\\n\\s*[A-Z_]+: [\'"]?(?<currentValue>[^\'"\\s]+)',
      ],
      // These are exact pins. NuGet versioning would read 5.7.1 as ">= 5.7.1".
      versioningTemplate: 'semver-coerced',
    },
    {
      customType: 'regex',
      description: 'Release downloads in Ansible roles: the tag and the SHA-256 of the file',
      managerFilePatterns: ['/^infra/ansible/roles/[^/]+/defaults/main\\.yml$/'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>github-release-attachments) depName=(?<depName>\\S+)\\s*\\n[a-z_]+_version: (?<currentValue>\\S+)\\n[a-z_]+_url: .+\\n[a-z_]+_sha256: (?<currentDigest>[a-f0-9]{64})',
      ],
    },
    {
      customType: 'regex',
      description: 'Terraform in the Flatpak, kept in step with CI',
      managerFilePatterns: ['/^app/flatpak/[^/]+\\.ya?ml$/'],
      matchStrings: [
        'url: https://releases\\.hashicorp\\.com/terraform/(?<currentValue>[0-9.]+)/terraform_[0-9.]+_linux_amd64\\.zip',
      ],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'terraform',
      packageNameTemplate: 'hashicorp/terraform',
      extractVersionTemplate: '^v(?<version>.+)$',
    },
  ],

  packageRules: [
    // Glue from the flutter_rust_bridge template (cargokit vendored in it);
    // not ours to update.
    {
      matchFileNames: ['app/rust_builder/**'],
      enabled: false,
    },
    // Cargo.lock already pins every crate with a checksum, so dev-dependencies
    // keep their ranges (best-practices would pin them in Cargo.toml).
    {
      matchManagers: ['cargo'],
      matchDepTypes: ['dev-dependencies'],
      rangeStrategy: 'auto',
    },

    // Routine updates merge on their own once CI passes; majors wait for a
    // review.
    {
      matchUpdateTypes: ['minor', 'patch', 'digest', 'pinDigest'],
      automerge: true,
    },
    // Except where the release date comes from the tag's own commit (GitHub
    // Actions, pre-commit hooks, Go modules): whoever pushes the tag can
    // back-date it, so the 30-day wait can be faked there. A new digest on
    // the same tag means the tag was moved.
    {
      matchDatasources: ['github-tags', 'github-digest', 'git-tags', 'git-refs', 'go'],
      automerge: false,
    },

    // Exact Rust releases (1.99.0, not the 1.99 channel, which floats).
    {
      matchDatasources: ['rust-version'],
      versioning: 'rust-release-channel',
    },
    // CI's Python stays on 3.12, the version the locks are built for.
    {
      matchManagers: ['github-actions'],
      matchDepNames: ['python'],
      allowedVersions: '/^3\\.12\\./',
    },

    // One PR per area for the routine updates; majors stay separate.
    {
      groupName: 'GitHub Actions',
      matchManagers: ['github-actions'],
      matchDepTypes: ['action'],
      matchUpdateTypes: ['minor', 'patch', 'digest', 'pinDigest'],
    },
    {
      groupName: 'pre-commit hooks',
      matchManagers: ['pre-commit'],
      matchUpdateTypes: ['minor', 'patch', 'digest'],
    },
    {
      groupName: 'Rust crates',
      matchManagers: ['cargo'],
      matchUpdateTypes: ['minor', 'patch'],
    },
    {
      groupName: 'Dart packages',
      matchManagers: ['pub'],
      matchUpdateTypes: ['minor', 'patch'],
    },
    {
      groupName: 'Terraform providers',
      matchManagers: ['terraform', 'tflint-plugin'],
      matchUpdateTypes: ['minor', 'patch'],
    },
    {
      groupName: 'Ansible',
      matchFileNames: ['infra/ansible/**'],
      matchManagers: ['ansible-galaxy', 'pip-compile'],
      matchUpdateTypes: ['minor', 'patch'],
    },
    // A 0.x minor bump (base64 0.22 to 0.23) is breaking in Cargo and pub:
    // its own PR, reviewed, so it can't hold up the rest of the group.
    {
      matchManagers: ['cargo', 'pub'],
      matchIsBreaking: true,
      groupName: null,
      automerge: false,
    },

    // Updates that need a hand after Renovate's change, so they never merge
    // on their own.
    {
      groupName: 'Terraform CLI',
      matchDepNames: ['terraform'],
      automerge: false,
      prBodyNotes: [
        "Renovate can't hash the Flatpak's Terraform download: set `sha256` in `app/flatpak/io.github.sergimn.rega.yml` from the release's `SHA256SUMS` file on https://releases.hashicorp.com/terraform/ before merging.",
      ],
    },
    {
      groupName: 'flutter_rust_bridge',
      matchPackageNames: ['flutter_rust_bridge'],
      automerge: false,
      prBodyNotes: [
        'Regenerate the bindings with the same version of the codegen (`flutter_rust_bridge_codegen generate` in `app/`) before merging.',
      ],
    },
  ],
}
